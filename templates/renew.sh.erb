#!/usr/bin/env bash

set -eou pipefail


if [[ "${1:-}" == "force" ]] ; then
  force="--renew-days=100"
else
  force=""
fi

export AWS_SHARED_CREDENTIALS_FILE="<%= @creds_file %>"

/usr/bin/lego \
  run \
  "--path=<%= @path %>" \
  --dns=route53 \
  "--domains=<%= @hostname %>" \
  --accept-tos \
  "--email=<%= @email %>" \
  "--key-type=<%= @key_type %>" \
  --no-random-sleep \
  "--profile=<%= @profile %>" \
  "--deploy-hook=<%= @hook_file %>" \
  "--dns.propagation.disable-rns" \
  "$force"

